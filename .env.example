# ─────────────────────────────────────────────────────────────────────────────
# IGNIS — environment configuration (copy to .env.local and fill in)
#   cp .env.example .env.local
#
# ZERO-KEY DEMO MODE: every value below is OPTIONAL. With nothing set, IGNIS
# still runs on key-free NASA GIBS tiles (archive back to 2000). Adding the
# FIRMS MAP_KEY unlocks the full harmonized FIRMS near-real-time pipeline.
# ─────────────────────────────────────────────────────────────────────────────

# FIRMS MAP_KEY — free, https://firms.modaps.eosdis.nasa.gov/api/area/
# Unlocks: harmonized MODIS+VIIRS NRT hotspots (5 sensors), area CSV API.
FIRMS_MAP_KEY=

# api.nasa.gov key — free, https://api.nasa.gov/  (or use the shared DEMO_KEY)
# Unlocks: EONET natural-event feeds (fire weather panel), APOD health probe.
NASA_API_KEY=DEMO_KEY

# Earthdata Login JWT — https://urs.earthdata.nasa.gov/ → Generate Token
# Optional. Used by /api/health to verify Earthdata identity server-side.
EDL_TOKEN=

# Hugging Face token — https://huggingface.co/settings/tokens (read scope)
# Optional. Used by /api/analyst (grounded AI analyst chat) and /api/hf.
HF_TOKEN=

# Prisma (optional demo persistence layer — file-based SQLite)
DATABASE_URL="file:./db/custom.db"
